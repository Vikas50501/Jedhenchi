# Normalise line endings to LF in the repository.
# Without this, editing a file on Windows rewrites every line as CRLF and the
# next push shows the whole file as changed — which makes real diffs impossible
# to review and causes needless Shopify theme syncs.
* text=auto eol=lf

# Binary assets must never be line-ending converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.svg text eol=lf
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.mp4 binary
*.webm binary
*.pdf binary
