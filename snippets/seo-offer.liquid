{%- comment -%}
  ---------------------------------------------------------------------------
  seo-offer.liquid  --  portable, no per-store editing needed
  ---------------------------------------------------------------------------
  Emits one schema.org Offer object (no trailing comma).
  All configuration is passed in from seo-structured-data.liquid.

  Availability mapping:
    available + inventory tracked + qty <= 0  -> BackOrder  (continue selling)
    available                                  -> InStock
    otherwise                                  -> OutOfStock
  ---------------------------------------------------------------------------
{%- endcomment -%}
{%- liquid
  assign offer_url = canonical_url | append: '?variant=' | append: variant.id

  assign availability = 'OutOfStock'
  if variant.available
    if variant.inventory_management != blank and variant.inventory_quantity <= 0
      assign availability = 'BackOrder'
    else
      assign availability = 'InStock'
    endif
  endif

  if price_mode == 'divide'
    assign offer_price = variant.price | divided_by: 100.0
  else
    assign offer_price = variant.price | money_without_currency | replace: ',', '' | strip
  endif

  assign condition = product.metafields.seo.item_condition | default: 'NewCondition'
  assign valid_until = product.metafields.seo.price_valid_until.value | default: product.metafields.seo.price_valid_until
-%}
{
  "@type": "Offer",
  "url": {{ offer_url | json }},
  "price": {{ offer_price | json }},
  "priceCurrency": {{ cart.currency.iso_code | json }},
  "availability": "https://schema.org/{{ availability }}",
  "itemCondition": "https://schema.org/{{ condition }}",
  {%- if valid_until != blank %}
    "priceValidUntil": {{ valid_until | date: '%Y-%m-%d' | json }},
  {%- endif %}
  {%- if variant.sku != blank %}
    "sku": {{ variant.sku | json }},
  {%- endif %}
  {% render 'seo-gtin', barcode: variant.barcode %}
  {%- if shipping_enabled %}
    "shippingDetails": {
      "@type": "OfferShippingDetails",
      "shippingRate": {
        "@type": "MonetaryAmount",
        "value": {{ ship_rate | json }},
        "currency": {{ cart.currency.iso_code | json }}
      },
      "shippingDestination": {
        "@type": "DefinedRegion",
        "addressCountry": {{ ship_country | json }}
      },
      "deliveryTime": {
        "@type": "ShippingDeliveryTime",
        "handlingTime": {
          "@type": "QuantitativeValue",
          "minValue": {{ handling_min | json }},
          "maxValue": {{ handling_max | json }},
          "unitCode": "DAY"
        },
        "transitTime": {
          "@type": "QuantitativeValue",
          "minValue": {{ transit_min | json }},
          "maxValue": {{ transit_max | json }},
          "unitCode": "DAY"
        }
      }
    },
  {%- endif %}
  {%- if returns_enabled %}
    "hasMerchantReturnPolicy": {
      "@type": "MerchantReturnPolicy",
      "applicableCountry": {{ ship_country | json }},
      "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
      "merchantReturnDays": {{ return_days | json }},
      "returnMethod": "https://schema.org/{{ return_method }}",
      "returnFees": "https://schema.org/{{ return_fees }}"
    },
  {%- endif %}
  "seller": { "@id": {{ org_id | json }} }
}
