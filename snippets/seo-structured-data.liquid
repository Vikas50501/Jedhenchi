{%- comment -%}
  ===========================================================================
  seo-structured-data.liquid                                    v1.0
  ---------------------------------------------------------------------------
  Portable Shopify structured-data snippet. Emits exactly ONE
  application/ld+json block per page as a single @graph.

  ***  THE ONLY FILE YOU EDIT PER STORE IS THE CONFIG BLOCK BELOW.  ***

  Rendered from:
    product page     {% render 'seo-structured-data', product: product, collection: collection %}
    collection page  {% render 'seo-structured-data', collection: collection %}

  Requires: snippets/seo-offer.liquid, snippets/seo-gtin.liquid
  Requires: an Organization node with @id "<shop.url>#organization"
            (see SETUP-CHECKLIST.md step 4)

  Emits nothing visible. No CSS, no HTML, no layout impact.
  ===========================================================================
{%- endcomment -%}

{%- liquid
  # =========================================================================
  # CONFIG  --  edit this block only
  # =========================================================================

  # --- Shipping -------------------------------------------------------------
  # Values taken verbatim from /pages/shipping-policy (read 2026-08-21):
  #   "We offer free shipping on all prepaid domestic orders."   -> rate 0
  #   "Orders are generally delivered within 2-7 Days"           -> 2-7 days
  # That 2-7 window is the TOTAL time the page promises, so handling is 0 and
  # the whole window sits in transitTime. Do not split it, or the total
  # advertised on the page and the total in the schema stop matching.
  # If the shipping policy page changes, update these. The validator's policy
  # drift check will flag the mismatch.
  assign shipping_enabled = true
  # domestic only; policy covers India
  assign ship_country     = 'IN'
  # free on prepaid domestic orders
  assign ship_rate        = '0'
  # included in the 2-7 day total below
  assign handling_min     = 0
  assign handling_max     = 0
  # "delivered within 2-7 Days"
  assign transit_min      = 2
  assign transit_max      = 7

  # --- Returns --------------------------------------------------------------
  # DELIBERATELY OFF. The store's own pages contradict each other:
  #   /pages/refund-policy : "EXCHANGE & RETURN are not available for
  #                           Domestic/International orders"
  #   product page badges  : "60-Day Risk-Free Returns", "Money Return"
  # Encoding either version would publish a claim the other page disproves,
  # which is both a Google structured-data violation and a consumer-law
  # problem. Resolve the policy first, then set real values here.
  assign returns_enabled  = false
  assign return_days      = 30
  # or ReturnInStore
  assign return_method    = 'ReturnByMail'
  # or ReturnShippingFees
  assign return_fees      = 'FreeReturn'

  # --- Price format ---------------------------------------------------------
  # 'money'  = uses money_without_currency (correct for most stores)
  # 'divide' = use ONLY if the store formats money as 1.999,00 (comma decimal)
  assign price_mode = 'money'

  # --- Reviews --------------------------------------------------------------
  # Judge.me, Loox, Yotpo, Stamped and Shopify Product Reviews all write to
  # the standard reviews.rating / reviews.rating_count metafields, so this
  # works unchanged on most stores. Set to false to suppress ratings entirely.
  assign reviews_enabled = true

  # --- Images ---------------------------------------------------------------
  assign max_images = 10

  # =========================================================================
  # END CONFIG  --  nothing below needs editing
  # =========================================================================

  assign base_url = request.origin
  assign org_id = shop.url | append: '#organization'
-%}

{%- if request.page_type == 'product' and product != blank -%}

  {%- liquid
    assign canonical_url = base_url | append: '/products/' | append: product.handle
    assign product_id = canonical_url | append: '#product'

    assign seo_description = product.description | strip_html | strip_newlines | replace: '  ', ' ' | replace: '  ', ' ' | strip | truncate: 5000, ''

    assign brand_name = product.vendor | default: shop.name

    assign rating = nil
    assign rating_count = 0
    if reviews_enabled
      assign rating = product.metafields.reviews.rating.value
      assign rating_count = product.metafields.reviews.rating_count.value | default: product.metafields.reviews.rating_count | plus: 0
    endif

    assign variant_count = product.variants.size

    assign varies_raw = ''
    for option_name in product.options
      assign option_key = option_name | downcase
      if option_key contains 'color' or option_key contains 'colour' or option_key contains 'shade'
        assign varies_raw = varies_raw | append: 'https://schema.org/color|'
      elsif option_key contains 'size'
        assign varies_raw = varies_raw | append: 'https://schema.org/size|'
      elsif option_key contains 'material' or option_key contains 'fabric'
        assign varies_raw = varies_raw | append: 'https://schema.org/material|'
      elsif option_key contains 'pattern'
        assign varies_raw = varies_raw | append: 'https://schema.org/pattern|'
      endif
    endfor
    assign varies_by = varies_raw | split: '|'

    comment
      Generic catch-all collections make a useless breadcrumb
      ("Home > All > Product"), so skip them and fall back to a real one.
    endcomment
    assign breadcrumb_collection = collection
    if breadcrumb_collection == blank or breadcrumb_collection.handle == 'all' or breadcrumb_collection.handle == 'frontpage'
      assign breadcrumb_collection = nil
      for c in product.collections
        if c.handle != 'all' and c.handle != 'frontpage' and c.handle != 'home'
          assign breadcrumb_collection = c
          break
        endif
      endfor
    endif
  -%}

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {%- if variant_count > 1 -%}
          {
            "@type": "ProductGroup",
            "@id": {{ product_id | json }},
            "productGroupID": {{ product.id | json }},
            "name": {{ product.title | json }},
            "url": {{ canonical_url | json }},
            {%- if seo_description != blank %}
              "description": {{ seo_description | json }},
            {%- endif %}
            {%- if product.images.size > 0 %}
              "image": [
                {%- for image in product.images limit: max_images -%}
                  {{ image | image_url: width: 2048 | prepend: 'https:' | json }}
                  {%- unless forloop.last %},{% endunless -%}
                {%- endfor -%}
              ],
            {%- endif %}
            "brand": { "@type": "Brand", "name": {{ brand_name | json }} },
            {%- if varies_by.size > 0 %}
              "variesBy": [
                {%- for axis in varies_by -%}
                  {{ axis | json }}{%- unless forloop.last %},{% endunless -%}
                {%- endfor -%}
              ],
            {%- endif %}
            {%- if rating != blank and rating_count > 0 %}
              "aggregateRating": {
                "@type": "AggregateRating",
                "ratingValue": {{ rating.rating | json }},
                "bestRating": {{ rating.scale_max | json }},
                "worstRating": {{ rating.scale_min | json }},
                "reviewCount": {{ rating_count | json }}
              },
            {%- endif %}
            "hasVariant": [
              {%- for variant in product.variants -%}
                {%- liquid
                  assign variant_url = canonical_url | append: '?variant=' | append: variant.id
                  if variant.image
                    assign variant_image = variant.image
                  else
                    assign variant_image = product.featured_image
                  endif
                -%}
                {
                  "@type": "Product",
                  "@id": {{ variant_url | json }},
                  "name": {{ product.title | append: ' - ' | append: variant.title | json }},
                  "url": {{ variant_url | json }},
                  {%- if seo_description != blank %}
                    "description": {{ seo_description | json }},
                  {%- endif %}
                  {%- if variant_image %}
                    "image": [ {{ variant_image | image_url: width: 2048 | prepend: 'https:' | json }} ],
                  {%- endif %}
                  "brand": { "@type": "Brand", "name": {{ brand_name | json }} },
                  {%- if variant.sku != blank %}
                    "sku": {{ variant.sku | json }},
                  {%- endif %}
                  {% render 'seo-gtin', barcode: variant.barcode %}
                  {%- for option_name in product.options -%}
                    {%- liquid
                      assign option_key = option_name | downcase
                      assign option_index = forloop.index0
                      assign option_value = variant.options[option_index]
                    -%}
                    {%- if option_value != blank -%}
                      {%- if option_key contains 'color' or option_key contains 'colour' or option_key contains 'shade' -%}
                        "color": {{ option_value | json }},
                      {%- elsif option_key contains 'size' -%}
                        "size": {{ option_value | json }},
                      {%- elsif option_key contains 'material' or option_key contains 'fabric' -%}
                        "material": {{ option_value | json }},
                      {%- elsif option_key contains 'pattern' -%}
                        "pattern": {{ option_value | json }},
                      {%- endif -%}
                    {%- endif -%}
                  {%- endfor -%}
                  {%- if variant.weight > 0 %}
                    "weight": {
                      "@type": "QuantitativeValue",
                      "value": {{ variant.weight | json }},
                      "unitCode": "GRM"
                    },
                  {%- endif %}
                  "offers": {% render 'seo-offer',
                                product: product,
                                variant: variant,
                                canonical_url: canonical_url,
                                org_id: org_id,
                                price_mode: price_mode,
                                shipping_enabled: shipping_enabled,
                                ship_country: ship_country,
                                ship_rate: ship_rate,
                                handling_min: handling_min,
                                handling_max: handling_max,
                                transit_min: transit_min,
                                transit_max: transit_max,
                                returns_enabled: returns_enabled,
                                return_days: return_days,
                                return_method: return_method,
                                return_fees: return_fees %}
                }{%- unless forloop.last %},{% endunless -%}
              {%- endfor -%}
            ]
          },
        {%- else -%}
          {%- assign variant = product.selected_or_first_available_variant | default: product.variants.first -%}
          {
            "@type": "Product",
            "@id": {{ product_id | json }},
            "name": {{ product.title | json }},
            "url": {{ canonical_url | json }},
            {%- if seo_description != blank %}
              "description": {{ seo_description | json }},
            {%- endif %}
            {%- if product.images.size > 0 %}
              "image": [
                {%- for image in product.images limit: max_images -%}
                  {{ image | image_url: width: 2048 | prepend: 'https:' | json }}
                  {%- unless forloop.last %},{% endunless -%}
                {%- endfor -%}
              ],
            {%- endif %}
            "brand": { "@type": "Brand", "name": {{ brand_name | json }} },
            {%- if variant.sku != blank %}
              "sku": {{ variant.sku | json }},
            {%- endif %}
            {% render 'seo-gtin', barcode: variant.barcode %}
            {%- if variant.weight > 0 %}
              "weight": {
                "@type": "QuantitativeValue",
                "value": {{ variant.weight | json }},
                "unitCode": "GRM"
              },
            {%- endif %}
            {%- if rating != blank and rating_count > 0 %}
              "aggregateRating": {
                "@type": "AggregateRating",
                "ratingValue": {{ rating.rating | json }},
                "bestRating": {{ rating.scale_max | json }},
                "worstRating": {{ rating.scale_min | json }},
                "reviewCount": {{ rating_count | json }}
              },
            {%- endif %}
            "offers": {% render 'seo-offer',
                          product: product,
                          variant: variant,
                          canonical_url: canonical_url,
                          org_id: org_id,
                          price_mode: price_mode,
                          shipping_enabled: shipping_enabled,
                          ship_country: ship_country,
                          ship_rate: ship_rate,
                          handling_min: handling_min,
                          handling_max: handling_max,
                          transit_min: transit_min,
                          transit_max: transit_max,
                          returns_enabled: returns_enabled,
                          return_days: return_days,
                          return_method: return_method,
                          return_fees: return_fees %}
          },
        {%- endif -%}
        {
          "@type": "BreadcrumbList",
          "@id": {{ canonical_url | append: '#breadcrumb' | json }},
          "itemListElement": [
            {
              "@type": "ListItem",
              "position": 1,
              "name": "Home",
              "item": {{ base_url | json }}
            },
            {%- if breadcrumb_collection != blank and breadcrumb_collection.handle != blank %}
              {
                "@type": "ListItem",
                "position": 2,
                "name": {{ breadcrumb_collection.title | json }},
                "item": {{ base_url | append: '/collections/' | append: breadcrumb_collection.handle | json }}
              },
              {
                "@type": "ListItem",
                "position": 3,
                "name": {{ product.title | json }},
                "item": {{ canonical_url | json }}
              }
            {%- else %}
              {
                "@type": "ListItem",
                "position": 2,
                "name": {{ product.title | json }},
                "item": {{ canonical_url | json }}
              }
            {%- endif %}
          ]
        }
      ]
    }
  </script>

{%- elsif request.page_type == 'collection' and collection != blank -%}

  {%- liquid
    assign collection_url = base_url | append: '/collections/' | append: collection.handle
    comment
      Outside a paginate tag Liquid exposes at most 50 products, so
      numberOfItems must reflect what is actually listed.
    endcomment
    assign listed_products = collection.products
  -%}

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {%- if listed_products.size > 0 -%}
        {
          "@type": "ItemList",
          "@id": {{ collection_url | append: '#itemlist' | json }},
          "name": {{ collection.title | json }},
          "url": {{ collection_url | json }},
          "numberOfItems": {{ listed_products.size | json }},
          "itemListElement": [
            {%- for item in listed_products -%}
              {
                "@type": "ListItem",
                "position": {{ forloop.index }},
                "url": {{ base_url | append: '/products/' | append: item.handle | json }}
              }{%- unless forloop.last %},{% endunless -%}
            {%- endfor -%}
          ]
        },
        {%- endif -%}
        {
          "@type": "BreadcrumbList",
          "@id": {{ collection_url | append: '#breadcrumb' | json }},
          "itemListElement": [
            {
              "@type": "ListItem",
              "position": 1,
              "name": "Home",
              "item": {{ base_url | json }}
            },
            {
              "@type": "ListItem",
              "position": 2,
              "name": {{ collection.title | json }},
              "item": {{ collection_url | json }}
            }
          ]
        }
      ]
    }
  </script>

{%- endif -%}
