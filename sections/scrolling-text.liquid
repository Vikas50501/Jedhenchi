{%- liquid
  assign theme_rtl = false
  if settings.enable_rtl and settings.langauges_rtl == blank
    assign theme_rtl = true
  endif

  if settings.enable_rtl and settings.langauges_rtl != blank
    assign rtl_languages = settings.langauges_rtl | split: ','
    for language in rtl_languages
      if language == request.locale.iso_code
        assign theme_rtl = true
      endif
    endfor
  endif
-%}
{{ 'scrolling-text.css' | asset_url | stylesheet_tag }}
<script src="{{ 'scrolling-text.js' | asset_url }}" defer></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.mobile_padding_top }}px;
    padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    --padding-top: {{ section.settings.mobile_padding_top }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      --padding-top: {{ section.settings.padding_top }}px;
    }
  }

   #MainContent > :first-child .section--top-space-{{ section.id }} {
     margin-top: calc(var(--header-height) * var(--transparent-header-show));
   }
  .scrolling--layout-tilt-down {
    transform: skewY(4deg);
  }
  .scrolling--layout-tilt-up {
    transform: skewY(-4deg);
  }
{%- endstyle -%}
{%- if theme_rtl %}
  {{ 'scrolling-text-rtl.css' | asset_url | stylesheet_tag }}
{%- endif -%}
<div class="section-{{ section.id }}-padding  section--top-space-{{ section.id }} color-{{ section.settings.color_scheme }} gradient  {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
  <marquee-scroll
    class="scrolling--text scrolling--text--{{ section.settings.direction }}"
    style="--duration: {{ section.settings.speed }}s"
  >
    <div class="scrolling--item scrolling--animated">
      {%- for block in section.blocks -%}
        {% case block.type %}
          {% when 'announcement' %}
            <div
              class="scrolling--item__inner {% if section.settings.bullet_style %} scrolling--item-bullet{% endif %} column--gap-{{ section.settings.colun_gap }} {{ section.settings.text_size }}"
              {{ block.shopify_attributes }}
            >
              {%- render 'icon-scrolling-text', icon: block.settings.icon -%}
              <span class="scrolling--text__content {% if block.settings.text_stroke  %} scrolling--item__text--stroke {% endif %}">
                {{- block.settings.text -}}
              </span>
            </div>
          {% when 'image' %}
            <div
              class="scrolling--item__inner column--gap-{{ section.settings.colun_gap }} image--column"
              style="--scrolling-image-height: {{ block.settings.logo_width }}px;"
            >
              <div class="{% if block.settings.image != blank %}media media--transparent {% else %}logo--placeholder{% endif %}">
                {%- if block.settings.image != blank -%}
                  {%- capture sizes -%}100vw{%- endcapture -%}
                  {{
                    block.settings.image
                    | image_url: width: 550
                    | image_tag:
                      loading: 'lazy',
                      sizes: sizes,
                      widths: '275, 550, 710, 1420',
                      class: 'promotion__image image--fit'
                  }}
                {%- else -%}
                  {{ 'detailed-apparel-1' | placeholder_svg_tag: 'logo--placeholder-svg' }}
                {%- endif -%}
              </div>
            </div>
        {% endcase %}
      {%- endfor -%}
    </div>
  </marquee-scroll>
</div>

