<link rel="stylesheet" href="{{ 'component-rte.css' | asset_url }}" media="print" onload="this.media='all'">
{{ 'section-image-collage.css' | asset_url | stylesheet_tag }}
{{ 'section-title.css' | asset_url | stylesheet_tag }}
<noscript>{{ 'component-rte.css' | asset_url | stylesheet_tag }}</noscript>
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.mobile_padding_top }}px;
    padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  #MainContent > :first-child .section--top-space-{{ section.id }} {
    margin-top: calc(var(--header-height) * var(--transparent-header-show));
  }

  /* ── Wrapper: no horizontal overflow ── */
  .masonry--banner-wrapper {
    width: 100%;
    overflow-x: hidden;
    box-sizing: border-box;
  }

  /* ── Container safety on mobile ── */
  .masonry--banner-wrapper .container,
  .masonry--banner-wrapper .container-fluid {
    width: 100%;
    box-sizing: border-box;
  }

  /* ── Equal-size grid ── */
  .masonry-banner--equal-size {
    display: grid !important;
    grid-auto-rows: {% if section.settings.height == 'large' %}42rem{% elsif section.settings.height == 'medium' %}35rem{% else %}45rem{% endif %};
    gap: var(--grid-desktop-horizontal-spacing, 1rem);
    width: 100%;
    box-sizing: border-box;
  }
  .masonry-banner--equal-size.masonry-banner--grid--4 { grid-template-columns: repeat(4, 1fr) !important; }
  .masonry-banner--equal-size.masonry-banner--grid--3 { grid-template-columns: repeat(3, 1fr) !important; }
  .masonry-banner--equal-size.masonry-banner--grid--2 { grid-template-columns: repeat(2, 1fr) !important; }
  .masonry-banner--equal-size.masonry-banner--grid--1 { grid-template-columns: 1fr !important; }

  /* Each item fills its grid cell */
  .masonry-banner--equal-size .masonry--banner__items {
    grid-column: span 1 !important;
    grid-row: span 1 !important;
    position: relative !important;
    overflow: hidden !important;
    display: flex !important;
    flex-direction: column !important;
    height: 100% !important;
    width: 100% !important;
    box-sizing: border-box !important;
    min-width: 0 !important; /* Prevent grid blowout */
  }

  /* Link wrapper must also stretch full height */
  .masonry-banner--equal-size .masonry--banner__items .masonry--banner-link {
    display: flex !important;
    flex-direction: column !important;
    height: 100% !important;
    width: 100% !important;
    min-width: 0 !important;
  }

  /* Media fills the entire cell */
  .masonry-banner--equal-size .masonry--banner__items .banner__media {
    flex: 1 1 auto !important;
    width: 100% !important;
    height: 100% !important;
    min-height: 0 !important;
    position: relative !important;
    overflow: hidden !important;
    padding-bottom: 0 !important;
  }

  /* Image covers the full media box */
  .masonry-banner--equal-size .masonry--banner__items .banner__media img {
    position: absolute !important;
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    object-position: center !important;
    display: block !important;
    max-width: none !important;
    max-height: none !important;
  }

  /* Placeholder SVG also fills the box */
  .masonry-banner--equal-size .masonry--banner__items .banner__media .placeholder-svg-new {
    position: absolute !important;
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
  }

  /* Content overlay stays on top */
  .masonry-banner--equal-size .masonry--banner__items .banner__items--content {
    position: absolute !important;
    inset: 0 !important;
    z-index: 2 !important;
    display: flex !important;
    flex-direction: column !important;
    pointer-events: none !important;
  }
  .masonry-banner--equal-size .masonry--banner__items .banner__items--content * {
    pointer-events: auto !important;
  }

  /* ── Mobile ── */
  @media screen and (max-width: 749px) {

    /* Force wrapper & container to stay within viewport */
    .masonry--banner-wrapper {
      padding-left: 0 !important;
      padding-right: 0 !important;
    }
    .masonry--banner-wrapper .container,
    .masonry--banner-wrapper .container-fluid {
      padding-left: var(--grid-mobile-horizontal-spacing, 1rem) !important;
      padding-right: var(--grid-mobile-horizontal-spacing, 1rem) !important;
      max-width: 100vw !important;
      overflow-x: hidden !important;
    }
    /* px-0 override for full-bleed mode — keep zero on mobile too */
    .masonry--banner-wrapper .container-fluid.px-0 {
      padding-left: 0 !important;
      padding-right: 0 !important;
    }

    /* Grid: 4 and 3-col collapse to 2-col, 2 and 1-col stay single */
    .masonry-banner--equal-size.masonry-banner--grid--4,
    .masonry-banner--equal-size.masonry-banner--grid--3 {
      grid-template-columns: repeat(2, 1fr) !important;
    }
    .masonry-banner--equal-size.masonry-banner--grid--2,
    .masonry-banner--equal-size.masonry-banner--grid--1 {
      grid-template-columns: 1fr !important;
    }

    /* Row height on mobile */
    .masonry-banner--equal-size {
      grid-auto-rows: 22rem !important;
      gap: var(--grid-mobile-horizontal-spacing, 0.75rem) !important;
      width: 100% !important;
      min-width: 0 !important;
    }

    /* Ensure each cell never exceeds viewport */
    .masonry-banner--equal-size .masonry--banner__items {
      max-width: 100% !important;
      min-width: 0 !important;
      overflow: hidden !important;
    }

    /* Image must be fully contained inside its cell on mobile */
    .masonry-banner--equal-size .masonry--banner__items .banner__media {
      position: absolute !important;
      inset: 0 !important;
      width: 100% !important;
      height: 100% !important;
    }

    .masonry-banner--equal-size .masonry--banner__items .banner__media img {
      position: absolute !important;
      inset: 0 !important;
      width: 100% !important;
      height: 100% !important;
      object-fit: cover !important;
      object-position: center top !important; /* Show top of image on mobile */
    }

    /* Mobile image visibility toggle */
    .masonry--banner-card-desktop-image {
      display: none !important;
    }
    .masonry-banner--card-mobile-image {
      display: block !important;
    }

    /* Content text scaling on mobile */
    .masonry-banner--equal-size .masonry--banner__items .banner__items--content {
      padding: 0.75rem !important;
    }
    .masonry-banner--equal-size .masonry--banner__items .banner__items--content-inner {
      gap: 0.5rem !important;
    }
    .masonry-banner--equal-size .masonry--banner__items .banner__items--content__title {
      font-size: clamp(0.85rem, 3vw, 1.25rem) !important;
      line-height: 1.2 !important;
    }
    .masonry-banner--equal-size .masonry--banner__items .masonry--banner-item-text {
      font-size: clamp(0.75rem, 2.5vw, 0.9rem) !important;
      line-height: 1.3 !important;
    }
  }

  /* ── Desktop image visibility (mobile image hidden by default) ── */
  @media screen and (min-width: 750px) {
    .masonry--banner-card-desktop-image {
      display: block !important;
    }
    .masonry-banner--card-mobile-image {
      display: none !important;
    }
  }
{%- endstyle -%}

{% liquid
  if section.blocks.size >= 4
    assign grid_column = 'masonry-banner--grid--4 masonry-banner--equal-size'
  elsif section.blocks.size >= 3
    assign grid_column = 'masonry-banner--grid--3 masonry-banner--equal-size'
  elsif section.blocks.size >= 2
    assign grid_column = 'masonry-banner--grid--2 masonry-banner--equal-size'
  else
    assign grid_column = 'masonry-banner--grid--1 masonry-banner--equal-size'
  endif

  assign container = ''
  assign page_offset = false
  if section.settings.container == 'container'
    assign container = 'container'
  elsif section.settings.container == 'container-fluid'
    assign container = 'container-fluid'
    unless section.settings.show_offset
      assign page_offset = true
    endunless
  else
    assign container = 'container-fluid px-0'
  endif

  assign banner_height = ''
  if section.settings.height == 'medium'
    assign banner_height = '35rem'
  elsif section.settings.height == 'large'
    assign banner_height = '42rem'
  endif
%}

<div class="masonry--banner-wrapper section--top-space-{{ section.id }} section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient">
  <div class="{{ container }} {% if page_offset %}p-0{% endif %}">
    <div class="section-heading text-{{ section.settings.text_center }} mobile--text-{{ section.settings.mobile_text_center }} {% if section.settings.heading != blank or section.settings.description != blank %} mb-50{% endif %} {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      {% if section.settings.heading_position == 'bottom' and section.settings.description != blank %}
        <div class="section-heading__sub_title {{ section.settings.description_style }} rte">
          {{ section.settings.description -}}
        </div>
      {% endif %}
      <h2 class="section-heading__title {{ section.settings.heading_size }}">
        {{- section.settings.heading -}}
      </h2>
      {% if section.settings.heading_position == 'top' and section.settings.description != blank %}
        <div class="section-heading__sub_title {{ section.settings.description_style }} rte">
          {{ section.settings.description -}}
        </div>
      {% endif %}
    </div>
    <div
      class="gird masonry-banner--grid {{ grid_column }}"
      {% unless section.settings.height == 'small' %}
        style="--masonry-banner-height: {{ banner_height }}"
      {% endunless %}
    >
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {% when 'image_banner' %}
            {%- liquid
              assign content_position_class = block.settings.content_position

              case content_position_class
                when 'top_to_bottom'
                  assign content_position_class_assign = 'justify-content-between align-items-start'
                when 'top_to_bottom_center'
                  assign content_position_class_assign = 'justify-content-between align-items-center text-center'
                when 'top_to_bottom_right'
                  assign content_position_class_assign = 'justify-content-between align-items-end text-right'
                when 'top_left'
                  assign content_position_class_assign = 'justify-content-start align-items-start'
                when 'bottom_left'
                  assign content_position_class_assign = 'justify-content-end align-items-start'
                when 'center'
                  assign content_position_class_assign = 'justify-content-center align-items-center text-center'
                when 'top_center'
                  assign content_position_class_assign = 'justify-content-start align-items-center text-center'
                when 'bottom_center'
                  assign content_position_class_assign = 'justify-content-end align-items-center text-center'
                when 'middle_left'
                  assign content_position_class_assign = 'justify-content-center align-items-start'
                when 'top_right'
                  assign content_position_class_assign = 'justify-content-start align-items-end text-right'
                when 'middle_right'
                  assign content_position_class_assign = 'justify-content-center align-items-end text-right'
                else
                  assign content_position_class_assign = 'justify-content-end align-items-end text-right'
              endcase

              case block.settings.button_type
                when 'primary'
                  assign button_class = 'button button--primary'
                else
                  assign button_class = 'button button--secondary'
              endcase
            -%}

            <!-- Single banner start -->
            <div
              class="masonry--banner__items masonry--banner__items-{{ forloop.index }} {% if section.settings.mirrored %} masonry--item-right-large{% endif %} {% if section.settings.round_corner %}rounded--image{% endif %} {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
              {{ block.shopify_attributes }}
              {% if settings.animations_reveal_on_scroll %}
                data-cascade
                style="--animation-order: {{ forloop.index }};"
              {% endif %}
            >
              {% if block.settings.banner_link != blank -%}
                <a href="{{ block.settings.banner_link }}" class="masonry--banner-link">
              {%- endif %}

              {%- if block.settings.image != blank -%}
                <div class="banner__media media">
                  {%- capture sizes -%}(min-width: 990px) 900px, (min-width: 750px) 710px, calc(100vw - 30px){%- endcapture -%}
                  {% liquid
                    assign desktop_image_class = ''
                    if block.settings.mobile_image != blank
                      assign desktop_image_class = 'masonry--banner-card-desktop-image'
                    endif
                  %}
                  {{
                    block.settings.image
                    | image_url: width: 1420
                    | image_tag:
                      loading: 'lazy',
                      sizes: sizes,
                      widths: '275, 550, 710, 1420',
                      class: desktop_image_class
                  }}
                  {% if block.settings.mobile_image != blank %}
                    {{
                      block.settings.mobile_image
                      | image_url: width: 1420
                      | image_tag:
                        loading: 'lazy',
                        sizes: sizes,
                        widths: '275, 550, 710, 1420',
                        class: 'masonry-banner--card-mobile-image'
                    }}
                  {% endif %}
                </div>
              {% else %}
                <div class="banner__media media placeholder">
                  {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg-new' }}
                </div>
              {% endif %}

              <div class="banner__items--content masonry--banner-padded-{{ block.settings.card_padding }} collage--banner-content color-{{ block.settings.color_scheme }}">
                <div class="banner__items--content-inner {{ content_position_class_assign }}">
                  {% if block.settings.subheading != blank %}
                    <div class="masonry--banner-subtitle-wrapper {% if block.settings.subheading_style == "tag" %} color-{{ block.settings.subheading_color_scheme }}{% endif %}">
                      <span class="masonry--banner-subtitle subheading--style-{{ block.settings.subheading_style }}">
                        {{- block.settings.subheading -}}
                      </span>
                    </div>
                  {% endif %}

                  {% if block.settings.heading != blank or block.settings.description != blank %}
                    <div class="masonry--banner-middle-content">
                      <h2 class="banner__items--content__title {{ block.settings.heading_size }} mb-0">
                        {{
                          block.settings.heading
                          | replace: 'p>', 'span>'
                          | replace: 'h1>', 'span>'
                          | replace: 'h2>', 'span>'
                          | replace: 'h3>', 'span>'
                          | replace: 'h4>', 'span>'
                          | replace: 'h5>', 'span>'
                          | replace: 'h6>', 'span>'
                        }}
                      </h2>
                      {% if block.settings.description != blank %}
                        <p class="masonry--banner-item-text">
                          {{
                            block.settings.description
                            | replace: 'p>', 'span>'
                            | replace: 'h1>', 'span>'
                            | replace: 'h2>', 'span>'
                            | replace: 'h3>', 'span>'
                            | replace: 'h4>', 'span>'
                            | replace: 'h5>', 'span>'
                            | replace: 'h6>', 'span>'
                          }}
                        </p>
                      {% endif %}
                    </div>
                  {% endif %}

                  {% if block.settings.button_type == 'icon' and block.settings.button_label != blank %}
                    <span class="banner__items--content__link link with--icon button--with-icon {% if block.settings.underline %} button__underline {% endif %}">
                      {{ block.settings.button_label }}
                      {% if block.settings.button_icon %}
                        <span class="button--icon button--icon-right"> {% render 'icon-chevron-right' %}</span>
                      {% endif %}
                    </span>
                  {% endif %}

                  {% unless block.settings.button_type == 'icon' %}
                    {% if block.settings.button_label != blank %}
                      <button class="{{ button_class }} button--{{ block.settings.button_size }} {% if block.settings.button_icon %} button--with-icon{% endif %} collage__banner--button">
                        {{- block.settings.button_label | escape }}
                        {% if block.settings.button_icon %}
                          <span class="button--icon button--icon-right">{% render 'icon-chevron-right' %}</span>
                        {% endif %}
                      </button>
                    {% endif %}
                  {% endunless %}
                </div>
              </div>

              {% if block.settings.banner_link != blank %}</a>{% endif %}
            </div>
            <!-- Single banner ./ -->
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Masonry banner",
  "max_blocks": 4,
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "container",
      "label": "Page width",
      "default": "container",
      "info": "It will affect on the larger screen",
      "options": [
        { "value": "container", "label": "Boxed" },
        { "value": "container-fluid", "label": "Full width" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_offset",
      "label": "Enable horizontal space",
      "default": true,
      "info": "It will work if you select the \"Full width\" of the page width"
    },
    {
      "type": "header",
      "content": "Section header"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Masonry banner",
      "label": "t:sections.featured-collection.settings.title.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h1", "label": "Large" },
        { "value": "h2", "label": "Medium" },
        { "value": "h3", "label": "Small" }
      ],
      "default": "h2",
      "label": "Heading size"
    },
    {
      "type": "select",
      "id": "heading_position",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "top",
      "label": "Heading position"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "select",
      "id": "text_center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center",
      "label": "Desktop alignment"
    },
    {
      "type": "select",
      "id": "mobile_text_center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center",
      "label": "Mobile alignment"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "mirrored",
      "label": "Mirrored",
      "default": false
    },
    {
      "type": "select",
      "id": "height",
      "options": [
        { "value": "small", "label": "t:sections.image-with-text.settings.height.options__2.label" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "t:sections.image-with-text.settings.height.options__3.label" }
      ],
      "default": "small",
      "label": "Image height on desktop"
    },
    {
      "type": "checkbox",
      "id": "round_corner",
      "label": "Round corner",
      "default": true
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    { "type": "paragraph", "content": "Desktop" },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding top",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding bottom",
      "default": 50
    },
    { "type": "paragraph", "content": "Mobile" },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding top",
      "default": 50
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0, "max": 150, "step": 5, "unit": "px",
      "label": "Padding bottom",
      "default": 50
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "background-1"
    }
  ],
  "blocks": [
    {
      "type": "image_banner",
      "name": "Image banner",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "subheading",
          "default": "SUBHEADING",
          "label": "Subheading"
        },
        {
          "type": "select",
          "id": "subheading_style",
          "options": [
            { "value": "tag", "label": "Tag" },
            { "value": "text", "label": "Text" }
          ],
          "default": "tag",
          "label": "Subheading style"
        },
        {
          "type": "color_scheme",
          "id": "subheading_color_scheme",
          "label": "Subheading tag color scheme",
          "default": "background-1"
        },
        {
          "type": "richtext",
          "id": "heading",
          "default": "<p>heading</p>",
          "label": "Heading"
        },
        {
          "type": "select",
          "id": "heading_size",
          "options": [
            { "value": "h4", "label": "Small" },
            { "value": "h3", "label": "Medium" },
            { "value": "h2", "label": "Large" }
          ],
          "default": "h4",
          "label": "Heading size"
        },
        {
          "type": "richtext",
          "id": "description",
          "default": "<p>Description</p>",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "button_label",
          "default": "Shop now",
          "label": "Button label"
        },
        {
          "type": "checkbox",
          "id": "button_icon",
          "label": "Use arrow icon",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "underline",
          "label": "Use underline",
          "default": false
        },
        {
          "type": "url",
          "id": "banner_link",
          "label": "Button link"
        },
        {
          "type": "select",
          "id": "button_type",
          "label": "Button type",
          "default": "icon",
          "options": [
            { "value": "primary", "label": "t:sections.all.buttons.settings.solid_button.label" },
            { "value": "secondary", "label": "t:sections.all.buttons.settings.outline_button.label" },
            { "value": "icon", "label": "t:sections.all.buttons.settings.link_button.label" }
          ]
        },
        {
          "type": "select",
          "id": "button_size",
          "label": "Button size",
          "default": "small",
          "info": "Works on the solid/outline button",
          "options": [
            { "value": "large", "label": "Large" },
            { "value": "medium", "label": "Medium" },
            { "value": "small", "label": "Small" },
            { "value": "extra-small", "label": "Extra small" }
          ]
        },
        {
          "type": "select",
          "id": "content_position",
          "options": [
            { "value": "top_to_bottom", "label": "Top to bottom align left" },
            { "value": "top_to_bottom_center", "label": "Top to bottom align center" },
