<!-- ═══════════════════════════════════════════════════════════════════
     CUSTOM GALLERY JAVASCRIPT
     ═══════════════════════════════════════════════════════════════════ -->
<script>
(function() {
  'use strict';

  function initGallery(sectionId) {
    var gallery    = document.getElementById('ProductGallery-' + sectionId);
    var lightbox   = document.getElementById('GalleryLightbox-' + sectionId);
    if (!gallery) return;

    var slides     = gallery.querySelectorAll('.gallery-slide');
    var dots       = gallery.querySelectorAll('[data-dot]');
    var thumbs     = gallery.querySelectorAll('[data-thumb]');
    var prevBtn    = gallery.querySelector('[data-gallery-prev]');
    var nextBtn    = gallery.querySelector('[data-gallery-next]');
    var mainView   = gallery.querySelector('.product__gallery-main');

    /* Lightbox elements */
    var lbSlides   = lightbox ? lightbox.querySelectorAll('.gallery-lightbox__slide') : [];
    var lbDots     = lightbox ? lightbox.querySelectorAll('[data-lb-dot]') : [];
    var lbPrev     = lightbox ? lightbox.querySelector('[data-lb-prev]') : null;
    var lbNext     = lightbox ? lightbox.querySelector('[data-lb-next]') : null;
    var lbClose    = lightbox ? document.getElementById('LightboxClose-' + sectionId) : null;
    var lbCounter  = lightbox ? document.getElementById('LightboxCounter-' + sectionId) : null;

    var current = 0;
    var total   = slides.length;

    /* ── Measure scrollbar width once (prevents layout jump on lock) ── */
    var scrollbarWidth = window.innerWidth - document.documentElement.clientWidth;
    document.documentElement.style.setProperty('--scrollbar-width', scrollbarWidth + 'px');

    /* ── goTo: update main slide + dots + vertical thumbs ── */
    function goTo(idx) {
      if (total === 0) return;
      idx = ((idx % total) + total) % total;

      slides[current].classList.remove('active');
      if (dots[current])   dots[current].classList.remove('active');
      if (thumbs[current]) thumbs[current].classList.remove('active');

      current = idx;

      slides[current].classList.add('active');
      if (dots[current])   dots[current].classList.add('active');
      if (thumbs[current]) {
        thumbs[current].classList.add('active');
        /* scroll vertical thumb column so active thumb is visible */
        thumbs[current].scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    }

    /* ── Main viewer controls ── */
    if (prevBtn) prevBtn.addEventListener('click', function() { goTo(current - 1); });
    if (nextBtn) nextBtn.addEventListener('click', function() { goTo(current + 1); });

    dots.forEach(function(dot) {
      dot.addEventListener('click', function() { goTo(parseInt(dot.dataset.dot, 10)); });
    });

    thumbs.forEach(function(thumb) {
      thumb.addEventListener('click', function() { goTo(parseInt(thumb.dataset.thumb, 10)); });
    });

    /* ── Swipe on main viewer ── */
    var touchStartX = 0;
    if (mainView) {
      mainView.addEventListener('touchstart', function(e) {
        touchStartX = e.touches[0].clientX;
      }, { passive: true });
      mainView.addEventListener('touchend', function(e) {
        var diff = touchStartX - e.changedTouches[0].clientX;
        if (Math.abs(diff) > 40) goTo(diff > 0 ? current + 1 : current - 1);
      });
    }

    /* ── Listen for variant-change goTo requests ── */
    gallery.addEventListener('gallery:goTo', function(e) {
      if (e.detail && typeof e.detail.index === 'number') {
        goTo(e.detail.index);
      }
    });

    /* ── Lightbox ── */
    if (!lightbox) return;

    var lbCurrent = 0;

    function lbGoTo(idx) {
      if (lbSlides.length === 0) return;
      idx = ((idx % total) + total) % total;

      lbSlides[lbCurrent].classList.remove('active');
      if (lbDots[lbCurrent]) lbDots[lbCurrent].classList.remove('active');

      lbCurrent = idx;

      lbSlides[lbCurrent].classList.add('active');
      if (lbDots[lbCurrent]) lbDots[lbCurrent].classList.add('active');
      if (lbCounter) lbCounter.textContent = (lbCurrent + 1) + ' / ' + total;
    }

    function lockScroll() {
      var sw = window.innerWidth - document.documentElement.clientWidth;
      document.documentElement.style.setProperty('--scrollbar-width', sw + 'px');
      document.body.classList.add('lightbox-open');
    }

    function unlockScroll() {
      document.body.classList.remove('lightbox-open');
    }

    function openLightbox(idx) {
      lbGoTo(idx);
      lightbox.classList.add('open');
      lockScroll();
    }

    function closeLightbox() {
      lightbox.classList.remove('open');
      unlockScroll();
    }

    if (mainView) {
      mainView.addEventListener('click', function(e) {
        if (e.target.closest('.gallery-arrow')) return;
        openLightbox(current);
      });
    }

    if (lbClose) lbClose.addEventListener('click', closeLightbox);
    if (lbPrev)  lbPrev.addEventListener('click',  function(e) { e.stopPropagation(); lbGoTo(lbCurrent - 1); });
    if (lbNext)  lbNext.addEventListener('click',  function(e) { e.stopPropagation(); lbGoTo(lbCurrent + 1); });

    lbDots.forEach(function(dot) {
      dot.addEventListener('click', function() { lbGoTo(parseInt(dot.dataset.lbDot, 10)); });
    });

    lightbox.addEventListener('click', function(e) {
      if (e.target === lightbox) closeLightbox();
    });

    document.addEventListener('keydown', function(e) {
      if (!lightbox.classList.contains('open')) return;
      if (e.key === 'Escape')     { e.preventDefault(); closeLightbox(); }
      if (e.key === 'ArrowLeft')  { e.preventDefault(); lbGoTo(lbCurrent - 1); }
      if (e.key === 'ArrowRight') { e.preventDefault(); lbGoTo(lbCurrent + 1); }
    });

    var lbTouchX = 0;
    lightbox.addEventListener('touchstart', function(e) {
      lbTouchX = e.touches[0].clientX;
    }, { passive: true });
    lightbox.addEventListener('touchend', function(e) {
      var diff = lbTouchX - e.changedTouches[0].clientX;
      if (Math.abs(diff) > 40) lbGoTo(diff > 0 ? lbCurrent + 1 : lbCurrent - 1);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() {
      initGallery('{{ section.id }}');
    });
  } else {
    initGallery('{{ section.id }}');
  }
})();
</script>

<script>
(function () {
  'use strict';

  var SECTION_ID = '{{ section.id }}';

  function patchClass(Klass) {
    if (!Klass || Klass.__galleryPatched) return;
    Klass.__galleryPatched = true;

    var _original = Klass.prototype.updateMedia;

    Klass.prototype.updateMedia = function () {
      try {
        _original.call(this);
      } catch (e) {
        /* Swallow null-reference when media-gallery is absent */
      }

      var variant = this.currentVariant;
      if (!variant) return;

      var sectionId = (this.dataset && this.dataset.section) ? this.dataset.section : SECTION_ID;
      var gallery   = document.getElementById('ProductGallery-' + sectionId);
      if (!gallery) return;

      if (variant.featured_image && variant.featured_image.id) {
        var targetId = String(variant.featured_image.id);
        var slides   = gallery.querySelectorAll('.gallery-slide[data-media-id]');
        for (var i = 0; i < slides.length; i++) {
          if (slides[i].dataset.mediaId === targetId) {
            gallery.dispatchEvent(new CustomEvent('gallery:goTo', { detail: { index: i } }));
            return;
          }
        }
      }

      if (variant.featured_image && variant.featured_image.src) {
        var rawSrc   = variant.featured_image.src;
        var baseName = rawSrc
          .replace(/^https?:/, '')
          .replace(/\?.*$/, '')
          .replace(/_\d+x(\d+x)?\./, '.');
        var fileName = baseName.split('/').pop().replace(/\.[^.]+$/, '');

        var allSlides = gallery.querySelectorAll('.gallery-slide');
        for (var j = 0; j < allSlides.length; j++) {
          var img = allSlides[j].querySelector('img');
          if (!img) continue;
          var imgSrc = img.src
            .replace(/^https?:/, '')
            .replace(/\?.*$/, '')
            .replace(/_\d+x(\d+x)?\./, '.');
          if (imgSrc.indexOf(fileName) !== -1) {
            gallery.dispatchEvent(new CustomEvent('gallery:goTo', { detail: { index: j } }));
            return;
          }
        }
      }
    };
  }

  function tryPatch() {
    var patched = false;
    if (window.VariantRadios)  { patchClass(window.VariantRadios);  patched = true; }
    if (window.VariantSelects) { patchClass(window.VariantSelects); patched = true; }
    if (customElements && customElements.get) {
      var vrClass = customElements.get('variant-radios');
      var vsClass = customElements.get('variant-selects');
      if (vrClass) { patchClass(vrClass); patched = true; }
      if (vsClass) { patchClass(vsClass); patched = true; }
    }
    return patched;
  }

  function init() {
    if (tryPatch()) return;
    var attempts = 0;
    var timer = setInterval(function () {
      attempts++;
      if (tryPatch() || attempts >= 40) clearInterval(timer);
    }, 50);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>

