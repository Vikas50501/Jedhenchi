{% comment %}
  JEDHENCHI Difference — Theme-matched section
  Matches jedhenchi.com: white bg, dark cards, pill buttons, clean sans-serif
{% endcomment %}

<section
  id="jd-diff-{{ section.id }}"
  class="jd-diff-section"
  style="
    --jd-section-bg:        {{ section.settings.section_bg }};
    --jd-card-bg:           {{ section.settings.card_bg }};
    --jd-card-hover-bg:     {{ section.settings.card_hover_bg }};
    --jd-heading-color:     {{ section.settings.heading_color }};
    --jd-card-heading:      {{ section.settings.card_heading_color }};
    --jd-card-body:         {{ section.settings.card_body_color }};
    --jd-card-tagline:      {{ section.settings.card_tagline_color }};
    --jd-badge-bg:          {{ section.settings.badge_bg }};
    --jd-badge-text:        {{ section.settings.badge_text_color }};
    --jd-btn-bg:            {{ section.settings.btn_bg }};
    --jd-btn-text:          {{ section.settings.btn_text_color }};
    --jd-btn-hover-bg:      {{ section.settings.btn_hover_bg }};
    --jd-icon-color:        {{ section.settings.icon_color }};
    --jd-card-radius:       {{ section.settings.card_radius }}px;
    --jd-padding-top:       {{ section.settings.padding_top }}px;
    --jd-padding-bottom:    {{ section.settings.padding_bottom }}px;
    --jd-gap:               {{ section.settings.card_gap }}px;
  "
>
  <div class="jd-diff-wrap">

    {%- comment -%} ── Section Header ── {%- endcomment -%}
    <div class="jd-diff-header jd-align-{{ section.settings.header_align }}">
      {%- if section.settings.eyebrow != blank -%}
        <p class="jd-diff-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <{{ section.settings.title_tag }} class="jd-diff-title">
          {{ section.settings.title }}
        </{{ section.settings.title_tag }}>
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}
        <p class="jd-diff-subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>

    {%- comment -%} ── Cards Grid ── {%- endcomment -%}
    <div class="jd-diff-grid jd-cols-{{ section.settings.columns }}">
      {%- for block in section.blocks -%}
        {%- if block.type == 'card' -%}
          <div
            class="jd-diff-card"
            {{ block.shopify_attributes }}
            style="animation-delay:{{ forloop.index0 | times: 130 }}ms;"
          >

            {%- if block.settings.badge != blank -%}
              <span class="jd-diff-badge">{{ block.settings.badge }}</span>
            {%- endif -%}

            {%- if block.settings.show_icon -%}
              <div class="jd-diff-icon">
                {%- case block.settings.icon -%}
                  {%- when 'plane' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2L11 13M22 2L15 22l-4-9-9-4 19-7z"/></svg>
                  {%- when 'shield' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                  {%- when 'refresh' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-4.97"/></svg>
                  {%- when 'check' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                  {%- when 'clock' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                  {%- when 'star' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                  {%- when 'tag' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
                  {%- when 'heart' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                  {%- else -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                {%- endcase -%}
              </div>
            {%- endif -%}

            {%- if block.settings.stat_number != blank -%}
              <div class="jd-diff-stat">
                <span class="jd-diff-stat-num">{{ block.settings.stat_number }}</span>
                {%- if block.settings.stat_unit != blank -%}
                  <span class="jd-diff-stat-unit">{{ block.settings.stat_unit }}</span>
                {%- endif -%}
              </div>
            {%- endif -%}

            <div class="jd-diff-text">
              {%- if block.settings.title != blank -%}
                <h3 class="jd-diff-card-title">{{ block.settings.title }}</h3>
              {%- endif -%}
              {%- if block.settings.tagline != blank -%}
                <p class="jd-diff-card-tagline">{{ block.settings.tagline }}</p>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <div class="jd-diff-card-desc">{{ block.settings.description }}</div>
              {%- endif -%}
            </div>

            {%- if block.settings.btn_label != blank -%}
              <a
                href="{{ block.settings.btn_url | default: '#' }}"
                class="jd-diff-btn"
                {% if block.settings.btn_new_tab %}target="_blank" rel="noopener"{% endif %}
              >
                {{ block.settings.btn_label }}
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </a>
            {%- endif -%}

          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.show_cta and section.settings.cta_label != blank -%}
      <div class="jd-diff-cta jd-align-{{ section.settings.header_align }}">
        {%- if section.settings.cta_note != blank -%}
          <p class="jd-diff-cta-note">{{ section.settings.cta_note }}</p>
        {%- endif -%}
        <a href="{{ section.settings.cta_url | default: '#' }}" class="jd-diff-btn jd-diff-btn--lg">
          {{ section.settings.cta_label }}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>
    {%- endif -%}

  </div>
</section>

<style>
/* ==========================================================
   JEDHENCHI Difference — Matched to jedhenchi.com theme
   White page · Dark charcoal cards · Pill buttons
   ========================================================== */

#jd-diff-{{ section.id }} {
  background-color: var(--jd-section-bg);
  padding-top: var(--jd-padding-top);
  padding-bottom: var(--jd-padding-bottom);
}

.jd-diff-wrap {
  max-width: {{ section.settings.max_width }}px;
  margin: 0 auto;
  padding: 0 {{ section.settings.side_padding }}px;
}

/* ── Header ─────────────────────────────── */
.jd-diff-header { margin-bottom: {{ section.settings.header_gap }}px; }
.jd-align-center { text-align: center; }
.jd-align-left   { text-align: left; }
.jd-align-right  { text-align: right; }

.jd-diff-eyebrow {
  display: inline-block;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: #888888;
  margin: 0 0 10px;
}

.jd-diff-title {
  font-size: clamp({{ section.settings.title_size_min }}px, 3.5vw, {{ section.settings.title_size_max }}px);
  font-weight: {{ section.settings.title_weight }};
  color: var(--jd-heading-color);
  margin: 0 0 14px;
  line-height: 1.15;
  letter-spacing: -0.025em;
}

.jd-diff-subtitle {
  font-size: {{ section.settings.subtitle_size }}px;
  color: #666666;
  max-width: 540px;
  margin: 0 {% if section.settings.header_align == 'center' %}auto{% else %}0{% endif %};
  line-height: 1.6;
}

/* ── Grid ────────────────────────────────── */
.jd-diff-grid {
  display: grid;
  gap: var(--jd-gap);
}
.jd-cols-1 { grid-template-columns: 1fr; }
.jd-cols-2 { grid-template-columns: repeat(2, 1fr); }
.jd-cols-3 { grid-template-columns: repeat(3, 1fr); }
.jd-cols-4 { grid-template-columns: repeat(4, 1fr); }

@media (max-width: 1024px) {
  .jd-cols-3, .jd-cols-4 { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 640px) {
  .jd-cols-2, .jd-cols-3, .jd-cols-4 { grid-template-columns: 1fr; }
  .jd-diff-wrap { padding: 0 20px; }
}

/* ── Card ─ matches dark category cards on jedhenchi.com ── */
.jd-diff-card {
  position: relative;
  background-color: var(--jd-card-bg);
  border-radius: var(--jd-card-radius);
  padding: {{ section.settings.card_padding }}px;
  display: flex;
  flex-direction: column;
  gap: 16px;
  overflow: hidden;
  transition: background-color 0.25s ease, transform 0.25s cubic-bezier(.22,.68,0,1.2);
  opacity: 0;
  transform: translateY(18px);
  animation: jdCardIn 0.5s ease forwards;
}

@keyframes jdCardIn { to { opacity: 1; transform: translateY(0); } }

.jd-diff-card:hover {
  background-color: var(--jd-card-hover-bg);
  transform: translateY(-4px);
}

/* subtle shimmer line at top edge */
.jd-diff-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.10), transparent);
  pointer-events: none;
}

/* ── Badge — white pill, matches site's "Best Seller" / "New Arrival" */
.jd-diff-badge {
  display: inline-block;
  align-self: flex-start;
  background: var(--jd-badge-bg);
  color: var(--jd-badge-text);
  font-size: {{ section.settings.badge_font_size }}px;
  font-weight: 600;
  padding: 5px 14px;
  border-radius: 100px;
  letter-spacing: 0.01em;
  line-height: 1.5;
}

/* ── Icon ─────────────────────────────────── */
.jd-diff-icon {
  width: {{ section.settings.icon_size }}px;
  height: {{ section.settings.icon_size }}px;
  color: var(--jd-icon-color);
  flex-shrink: 0;
  opacity: 0.85;
}
.jd-diff-icon svg { width: 100%; height: 100%; }

/* ── Big stat number ─────────────────────── */
.jd-diff-stat {
  display: flex;
  align-items: baseline;
  gap: 6px;
  line-height: 1;
}
.jd-diff-stat-num {
  font-size: {{ section.settings.stat_font_size }}px;
  font-weight: 800;
  color: #ffffff;
  letter-spacing: -0.04em;
  line-height: 1;
}
.jd-diff-stat-unit {
  font-size: 13px;
  font-weight: 500;
  color: rgba(255,255,255,0.45);
  text-transform: uppercase;
  letter-spacing: 0.1em;
}

/* ── Text ────────────────────────────────── */
.jd-diff-text {
  display: flex;
  flex-direction: column;
  gap: 8px;
  flex: 1;
}

.jd-diff-card-title {
  font-size: {{ section.settings.card_title_size }}px;
  font-weight: {{ section.settings.card_title_weight }};
  color: var(--jd-card-heading);
  margin: 0;
  line-height: 1.25;
  letter-spacing: -0.015em;
}

.jd-diff-card-tagline {
  font-size: {{ section.settings.card_tagline_size }}px;
  color: var(--jd-card-tagline);
  font-style: italic;
  margin: 0;
  line-height: 1.45;
}

.jd-diff-card-desc {
  font-size: {{ section.settings.card_body_size }}px;
  color: var(--jd-card-body);
  line-height: 1.65;
  margin: 0;
}
.jd-diff-card-desc p { margin: 0; }

/* ── Button — matches site's pill "Shop Now >" style ──── */
.jd-diff-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  align-self: flex-start;
  background: var(--jd-btn-bg);
  color: var(--jd-btn-text);
  font-size: {{ section.settings.btn_font_size }}px;
  font-weight: 600;
  padding: 11px 22px;
  border-radius: 100px;
  text-decoration: none;
  letter-spacing: 0.01em;
  transition: background-color 0.2s ease, transform 0.2s ease, gap 0.2s ease;
  margin-top: auto;
}
.jd-diff-btn:hover {
  background-color: var(--jd-btn-hover-bg);
  gap: 12px;
  transform: translateY(-1px);
}
.jd-diff-btn--lg {
  font-size: 15px;
  padding: 14px 32px;
}

/* ── Section CTA ─────────────────────────── */
.jd-diff-cta {
  margin-top: {{ section.settings.cta_gap }}px;
  display: flex;
  flex-direction: column;
  align-items: {% if section.settings.header_align == 'center' %}center{% elsif section.settings.header_align == 'right' %}flex-end{% else %}flex-start{% endif %};
  gap: 14px;
}
.jd-diff-cta-note {
  font-size: 14px;
  color: #888888;
  margin: 0;
}
</style>

{% schema %}
{
  "name": "JEDHENCHI Difference",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "header",
      "content": "📐 Layout"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns (Desktop)",
      "options": [
        { "value": "1", "label": "1 Column" },
        { "value": "2", "label": "2 Columns" },
        { "value": "3", "label": "3 Columns" },
        { "value": "4", "label": "4 Columns" }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 800, "max": 1600, "step": 40, "unit": "px",
      "label": "Container Max Width",
      "default": 1200
    },
    {
      "type": "range",
      "id": "side_padding",
      "min": 0, "max": 80, "step": 4, "unit": "px",
      "label": "Side Padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "card_gap",
      "min": 8, "max": 48, "step": 4, "unit": "px",
      "label": "Gap Between Cards",
      "default": 20
    },
    {
      "type": "range",
      "id": "card_padding",
      "min": 16, "max": 56, "step": 4, "unit": "px",
      "label": "Card Inner Padding",
      "default": 32
    },
    {
      "type": "range",
      "id": "card_radius",
